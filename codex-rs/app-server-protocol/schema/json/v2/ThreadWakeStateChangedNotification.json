{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadWakeState": {
      "description": "Live runtime waits; this does not affect whether user input is accepted.",
      "properties": {
        "pendingCount": {
          "description": "Number of distinct operations with a pending wake, including active waits.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "waiting": {
          "description": "True when idle or suspended solely on those operations.",
          "type": "boolean"
        }
      },
      "required": [
        "pendingCount",
        "waiting"
      ],
      "type": "object"
    }
  },
  "properties": {
    "threadId": {
      "type": "string"
    },
    "wakeState": {
      "$ref": "#/definitions/ThreadWakeState"
    }
  },
  "required": [
    "threadId",
    "wakeState"
  ],
  "title": "ThreadWakeStateChangedNotification",
  "type": "object"
}