{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "LegacyAppPathString": {
      "type": "string"
    },
    "WorkflowMetadata": {
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "phases": {
          "items": {
            "$ref": "#/definitions/WorkflowPhaseDefinition"
          },
          "type": "array"
        }
      },
      "required": [
        "description",
        "name",
        "phases"
      ],
      "type": "object"
    },
    "WorkflowMetrics": {
      "properties": {
        "activeDurationMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "agentsUsed": {
          "default": null,
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "modelTurns": {
          "default": null,
          "description": "Unique usage-bearing model responses; null means the count is unknown.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/definitions/WorkflowTokenUsage"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null means no reported usage checkpoint is available; zero is an observed zero."
        },
        "usageComplete": {
          "type": "boolean"
        },
        "usageIncompleteReason": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "wallDurationMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "usageComplete"
      ],
      "type": "object"
    },
    "WorkflowPhaseDefinition": {
      "properties": {
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "WorkflowPhaseProgress": {
      "properties": {
        "completedAt": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "metrics": {
          "allOf": [
            {
              "$ref": "#/definitions/WorkflowMetrics"
            }
          ],
          "default": {
            "activeDurationMs": null,
            "agentsUsed": null,
            "modelTurns": null,
            "usage": null,
            "usageComplete": false,
            "usageIncompleteReason": null,
            "wallDurationMs": null
          }
        },
        "status": {
          "$ref": "#/definitions/WorkflowPhaseStatus"
        },
        "stepsCompleted": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "stepsDiscovered": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "stepsCompleted",
        "stepsDiscovered",
        "title"
      ],
      "type": "object"
    },
    "WorkflowPhaseStatus": {
      "enum": [
        "pending",
        "active",
        "completed",
        "skipped",
        "failed"
      ],
      "type": "string"
    },
    "WorkflowRunLimits": {
      "properties": {
        "maxAgents": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "maxAgents"
      ],
      "type": "object"
    },
    "WorkflowStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "stopped",
        "interrupted"
      ],
      "type": "string"
    },
    "WorkflowSummary": {
      "properties": {
        "acceptedStarts": {
          "default": 0,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "executionId": {
          "default": "",
          "type": "string"
        },
        "formatVersion": {
          "default": 1,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "limits": {
          "allOf": [
            {
              "$ref": "#/definitions/WorkflowRunLimits"
            }
          ],
          "default": {
            "maxAgents": 32,
            "maxTokens": null
          }
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/definitions/WorkflowMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metrics": {
          "allOf": [
            {
              "$ref": "#/definitions/WorkflowMetrics"
            }
          ],
          "default": {
            "activeDurationMs": null,
            "agentsUsed": null,
            "modelTurns": null,
            "usage": null,
            "usageComplete": false,
            "usageIncompleteReason": null,
            "wallDurationMs": null
          }
        },
        "ownerThreadId": {
          "type": "string"
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "phaseCount": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "phaseProgress": {
          "default": [],
          "items": {
            "$ref": "#/definitions/WorkflowPhaseProgress"
          },
          "type": "array"
        },
        "projectRoot": {
          "anyOf": [
            {
              "$ref": "#/definitions/LegacyAppPathString"
            },
            {
              "type": "null"
            }
          ]
        },
        "readOnly": {
          "default": true,
          "type": "boolean"
        },
        "status": {
          "$ref": "#/definitions/WorkflowStatus"
        },
        "stepCount": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "createdAt",
        "id",
        "ownerThreadId",
        "phaseCount",
        "status",
        "stepCount",
        "updatedAt"
      ],
      "type": "object"
    },
    "WorkflowTokenUsage": {
      "properties": {
        "cachedInputTokens": {
          "description": "Included in inputTokens; it must not be added to input a second time.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "inputTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "outputTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "totalTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "inputTokens",
        "outputTokens",
        "totalTokens"
      ],
      "type": "object"
    }
  },
  "description": "Compact accounting checkpoints; full step details remain in workflow/updated and workflow/read.",
  "properties": {
    "threadId": {
      "type": "string"
    },
    "workflow": {
      "$ref": "#/definitions/WorkflowSummary"
    }
  },
  "required": [
    "threadId",
    "workflow"
  ],
  "title": "WorkflowProgressNotification",
  "type": "object"
}